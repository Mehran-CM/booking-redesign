    "enter-m": {
      "duration": 300,
      "easing": "ease-in-out",
      "reduced": "none"
    },
    "move-m": {
      "duration": 250,
      "easing": "ease-out",
      "reduced": "none"
    },
    "feedback-s": {
      "duration": 150,
      "easing": "ease-out",
      "reduced": "none"
    }
  }
