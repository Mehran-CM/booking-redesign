{
  "$description": "Booking.com mobile booking design contract. Updated 2026-11-04. This is a documented implementation palette, not a current Figma variable export. See $provenance before treating proposed values as verified.",
  "$provenance": {
    "verified_colors": [
      "#FFFFFF",
      "#F7F8FA",
      "#E1E4EA",
      "#C9CED8",
      "#1A4FD0",
      "#EEF4FF"
    ],
    "verified_source": "Earlier Desktop Bridge layer inspection in this conversation; live bridge disconnected during this update.",
    "proposed": "Other colors, typography, spacing, radii, shadows and reduced-motion defaults are proposed implementation values pending Figma comparison. Motion durations reflect inspected prototype reactions; semantic mapping is proposed.",
    "accessibility": "Existing border colors have measured contrast below 3:1 on white; border.default uses a proposed stronger color. These tokens are not a WCAG certification."
  },
  "color": {
    "base": {
      "brand-500": "#1A4FD0",
      "brand-50": "#EEF4FF",
      "white": "#FFFFFF",
      "neutral-50": "#F7F8FA",
      "neutral-200": "#E1E4EA",
      "neutral-300": "#C9CED8",
      "neutral-500": "#6B7280",
      "neutral-600": "#4B5563",
      "neutral-900": "#111827",
      "error-500": "#B42318",
      "error-50": "#FEF3F2",
      "success-500": "#166534",
      "success-50": "#F0FDF4",
      "yellow-400": "#FACC15"
    },
    "bg": {
      "page": "{color.base.neutral-50}",
      "surface": "{color.base.white}",
      "brand": "{color.base.brand-500}",
      "selected": "{color.base.brand-50}"
    },
    "text": {
      "primary": "{color.base.neutral-900}",
      "secondary": "{color.base.neutral-600}",
      "on-brand": "{color.base.white}",
      "error": "{color.base.error-500}"
    },
    "border": {
      "default": "{color.base.neutral-500}",
      "subtle": "{color.base.neutral-200}",
      "selected": "{color.base.brand-500}"
    },
    "badge": {
      "rating-bg": "{color.base.yellow-400}",
      "rating-text": "{color.base.neutral-900}",
      "cancellation-bg": "{color.base.success-50}",
      "cancellation-text": "{color.base.success-500}",
      "breakfast-bg": "{color.base.brand-50}",
      "breakfast-text": "{color.base.brand-500}"
    },
    "feedback": {
      "error-bg": "{color.base.error-50}",
      "error-text": "{color.base.error-500}",
      "focus": "{color.base.brand-500}"
    }
  },
  "font": {
    "family": "system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
    "text-styles": {
      "headline": {
        "size": 28,
        "lineHeight": 36,
        "weight": 700
      },
      "title": {
        "size": 20,
        "lineHeight": 28,
        "weight": 700
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "weight": 400
      },
      "caption": {
        "size": 12,
        "lineHeight": 18,
        "weight": 400
      },
      "label": {
        "size": 14,
        "lineHeight": 20,
        "weight": 600
      }
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 999
  },
  "shadow": {
    "low": "0 2px 8px rgba(17, 24, 39, 0.08)",
    "high": "0 8px 24px rgba(17, 24, 39, 0.16)"
  },
  "size": {
    "screen-width": 393,
    "viewport-height": 852,
    "touch-target": 44,
    "favorite-visual": 36,
    "icon": 20,
    "control-icon": 24,
    "result-card-width": 369,
    "result-card-height": 320,
    "result-photo-height": 170
